      "isDeleted": false,
      "boundElements": [],
      "updated": 1790922999395,
      "created": 1790914225716,
      "link": null,
      "locked": false,
      "text": "C = (i = 0, j = 2) - while ((k = 0) < n - 1) = (i , k) * (k, j) + (i, k+ 1) * (k + 1, j) + (i, k+2) * (k +2 ,j) ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C = (i = 0, j = 2) - while ((k = 0) < n - 1) = (i , k) * (k, j) + (i, k+ 1) * (k + 1, j) + (i, k+2) * (k +2 ,j) ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EvPrQ0wg61C_CN2g5Pblz",
