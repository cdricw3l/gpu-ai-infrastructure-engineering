      "seed": 97426184,
      "version": 235,
      "versionNonce": 1089958920,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790922104574,
      "created": 1790914080062,
      "link": null,
      "locked": false,
      "text": "A = (i=0, j =0) - while ((k = 0) < n - 1) = (i , k) * (k , j) + (i , k+ 1) * (k + 1, j) + (i , k + 2) * (k + 2, j) ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A = (i=0, j =0) - while ((k = 0) < n - 1) = (i , k) * (k , j) + (i , k+ 1) * (k + 1, j) + (i , k + 2) * (k + 2, j) ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "djkylTA65yKR-4kVfwE_R",
      "type": "text",
      "x": 861.3112385709317,
      "y": 94.07420355867467,
      "width": 797.4666748046875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
