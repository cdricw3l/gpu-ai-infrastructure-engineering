    {
      "id": "TC5PxaqNMLvwJaJMd95BF",
      "type": "text",
      "x": 862.2288228964837,
      "y": 68.00393549615683,
      "width": 793.6333618164062,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
