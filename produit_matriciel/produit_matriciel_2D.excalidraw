      "isDeleted": false,
      "boundElements": [],
      "updated": 1790922123111,
      "created": 1790914168074,
      "link": null,
      "locked": false,
      "text": "B = (i = 0, j = 1) - while ((k = 0) < n - 1)  = (i , k) * (k , j) + (i , k+1) * (k+1 , j) + (i ,k + 2) * (k + 2, j) ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "B = (i = 0, j = 1) - while ((k = 0) < n - 1)  = (i , k) * (k , j) + (i , k+1) * (k+1 , j) + (i ,k + 2) * (k + 2, j) ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FRtxg3OPyD9FeWbjJRZma",
      "type": "text",
      "x": 863.9540305729079,
      "y": 118.80753479747366,
      "width": 775.066650390625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
